namespace Eccelerators.Tokenization.Tests.Unigram
using Eccelerators.Tokenization.Unigram
component ArrayVocabulary : IUnigramVocabulary {
 wide: bool
 public fn Wide(value: bool) { wide = value }
 const COSTS: int[8] = [0, 1, 1, 2, 1, 1, 0, 1]
 override fn Next(node: int, value: byte) int {
  if (node == 0 && value == 60) { return 1 }
  if (node == 0 && value == 97) { return 6 }
  if (node == 0 && value == 98) { return 7 }
  if (node == 0 && value == 226) { return 9 }
  if (node == 0 && value == 195) { return 12 }
  if (node == 0 && value == 120) { return 18 }
  if (node == 1 && value == 117) { return 2 }
  if (node == 1 && value == 112) { return 14 }
  if (node == 2 && value == 110) { return 3 }
  if (node == 3 && value == 107) { return 4 }
  if (node == 4 && value == 62) { return 5 }
  if (node == 6 && value == 98) { return 8 }
  if (node == 9 && value == 150) { return 10 }
  if (node == 10 && value == 129) { return 11 }
  if (node == 12 && value == 169) { return 13 }
  if (node == 14 && value == 97) { return 15 }
  if (node == 15 && value == 100) { return 16 }
  if (node == 16 && value == 62) { return 17 }
  return -1
 }
 override fn Terminal(node: int) int {
  if (node == 5) { return 0 }
  if (node == 6) { return 1 }
  if (node == 7) { return 2 }
  if (node == 8) { return 3 }
  if (node == 11) { return 4 }
  if (node == 13) { return 5 }
  if (node == 17) { return 6 }
  if (node == 18) { return 7 }
  return -1
 }
 override fn Cost(token: int) logic[64] {
  if (wide) { return COSTS[token] as logic[64] << 39 }
  return COSTS[token] as logic[64]
 }
 override fn Unknown() int { return 0 }
 override fn UnknownCost() logic[64] { return 20 }
 override fn Failed() bool { return false }
 override fn TokenFlags(token: int) int { if (token < 0 || token > 8) { return -1 }
  if (token == 0 || token == 6) { return 1 }
  if (token == 8) { return 2 }
  return 0 }
 override fn TokenLength(token: int) int {
  if (token == 0) { return 5 }
  if (token == 1) { return 1 }
  if (token == 2) { return 1 }
  if (token == 3) { return 2 }
  if (token == 4) { return 3 }
  if (token == 5) { return 2 }
  if (token == 6) { return 5 }
  if (token == 7) { return 1 }
  return -1
 }
 override fn TokenByte(token: int, index: int) byte {
  if (token == 0 && index == 0) { return 60 }
  if (token == 0 && index == 1) { return 117 }
  if (token == 0 && index == 2) { return 110 }
  if (token == 0 && index == 3) { return 107 }
  if (token == 0 && index == 4) { return 62 }
  if (token == 1 && index == 0) { return 97 }
  if (token == 2 && index == 0) { return 98 }
  if (token == 3 && index == 0) { return 97 }
  if (token == 3 && index == 1) { return 98 }
  if (token == 4 && index == 0) { return 226 }
  if (token == 4 && index == 1) { return 150 }
  if (token == 4 && index == 2) { return 129 }
  if (token == 5 && index == 0) { return 195 }
  if (token == 5 && index == 1) { return 169 }
  if (token == 6 && index == 0) { return 60 }
  if (token == 6 && index == 1) { return 112 }
  if (token == 6 && index == 2) { return 97 }
  if (token == 6 && index == 3) { return 100 }
  if (token == 6 && index == 4) { return 62 }
  if (token == 7 && index == 0) { return 120 }
  return 0x00
 }
}
component BranchVocabulary : IUnigramVocabulary {
 override fn Next(node: int, value: byte) int {
  if (node == 0 && value == 60) { return 1 }
  if (node == 0 && value == 97) { return 6 }
  if (node == 0 && value == 98) { return 7 }
  if (node == 0 && value == 226) { return 9 }
  if (node == 0 && value == 195) { return 12 }
  if (node == 0 && value == 120) { return 18 }
  if (node == 1 && value == 117) { return 2 }
  if (node == 1 && value == 112) { return 14 }
  if (node == 2 && value == 110) { return 3 }
  if (node == 3 && value == 107) { return 4 }
  if (node == 4 && value == 62) { return 5 }
  if (node == 6 && value == 98) { return 8 }
  if (node == 9 && value == 150) { return 10 }
  if (node == 10 && value == 129) { return 11 }
  if (node == 12 && value == 169) { return 13 }
  if (node == 14 && value == 97) { return 15 }
  if (node == 15 && value == 100) { return 16 }
  if (node == 16 && value == 62) { return 17 }
  return -1
 }
 override fn Terminal(node: int) int {
  if (node == 5) { return 0 }
  if (node == 6) { return 1 }
  if (node == 7) { return 2 }
  if (node == 8) { return 3 }
  if (node == 11) { return 4 }
  if (node == 13) { return 5 }
  if (node == 17) { return 6 }
  if (node == 18) { return 7 }
  return -1
 }
 override fn Cost(token: int) logic[64] {
  if (token == 3) { return 2 }
  return 1
 }
 override fn Unknown() int { return 0 }
 override fn UnknownCost() logic[64] { return 20 }
 override fn Failed() bool { return false }
 override fn TokenFlags(token: int) int { if (token < 0 || token > 8) { return -1 }
  if (token == 0 || token == 6) { return 1 }
  if (token == 8) { return 2 }
  return 0 }
 override fn TokenLength(token: int) int {
  if (token == 0) { return 5 }
  if (token == 1) { return 1 }
  if (token == 2) { return 1 }
  if (token == 3) { return 2 }
  if (token == 4) { return 3 }
  if (token == 5) { return 2 }
  if (token == 6) { return 5 }
  if (token == 7) { return 1 }
  return -1
 }
 override fn TokenByte(token: int, index: int) byte {
  if (token == 0 && index == 0) { return 60 }
  if (token == 0 && index == 1) { return 117 }
  if (token == 0 && index == 2) { return 110 }
  if (token == 0 && index == 3) { return 107 }
  if (token == 0 && index == 4) { return 62 }
  if (token == 1 && index == 0) { return 97 }
  if (token == 2 && index == 0) { return 98 }
  if (token == 3 && index == 0) { return 97 }
  if (token == 3 && index == 1) { return 98 }
  if (token == 4 && index == 0) { return 226 }
  if (token == 4 && index == 1) { return 150 }
  if (token == 4 && index == 2) { return 129 }
  if (token == 5 && index == 0) { return 195 }
  if (token == 5 && index == 1) { return 169 }
  if (token == 6 && index == 0) { return 60 }
  if (token == 6 && index == 1) { return 112 }
  if (token == 6 && index == 2) { return 97 }
  if (token == 6 && index == 3) { return 100 }
  if (token == 6 && index == 4) { return 62 }
  if (token == 7 && index == 0) { return 120 }
  return 0x00
 }
}
component IdentityAscii : IAsciiNormalization { override fn Map(value: byte) int { return value as int } }
component LowerAscii : IAsciiNormalization { override fn Map(value: byte) int { if (value >= 0x41 && value <= 0x5a) { return (value as int) + 32 }
 return value as int } }
@Test
component UnigramTest {
 identity: IdentityAscii
 lowercase: LowerAscii
 a: ArrayVocabulary
 b: BranchVocabulary
 small: UnigramSegmenter<8, 4, ArrayVocabulary>
 large: UnigramSegmenter<32, 16, BranchVocabulary>
 norm: AsciiMetaspace<4, 15, IdentityAscii>
 lower: AsciiMetaspace<16, 51, LowerAscii>
 decoder: MetaspaceDecoder<8, 5, ArrayVocabulary>
 other: MetaspaceDecoder<32, 5, BranchVocabulary>
 new() { identity = new IdentityAscii()
  lowercase = new LowerAscii()
  a = new ArrayVocabulary()
  b = new BranchVocabulary()
  small = new UnigramSegmenter<8, 4, ArrayVocabulary>(a)
  large = new UnigramSegmenter<32, 16, BranchVocabulary>(b)
  norm = new AsciiMetaspace<4, 15, IdentityAscii>(identity)
  lower = new AsciiMetaspace<16, 51, LowerAscii>(lowercase)
  decoder = new MetaspaceDecoder<8, 5, ArrayVocabulary>(a)
  other = new MetaspaceDecoder<32, 5, BranchVocabulary>(b) }
 @Test fn ViterbiTiesUnknownFusionAndRepeatedSegments() {
  small.Reset()
  assert small.Accept(0x61)
  assert small.Accept(0x62)
  assert small.EncodeSegment()
  assert small.Count() == 1
  assert small.Token(0) == 3
  small.BeginSegment()
  assert small.Accept(0x7e)
  assert small.Accept(0x7e)
  assert small.EncodeSegment()
  assert small.Count() == 2
  assert small.Token(1) == 0
  small.BeginSegment()
  assert small.Accept(0x7e)
  assert small.EncodeSegment()
  assert small.Count() == 3
  large.Reset()
  assert large.Accept(0x61)
  assert large.Accept(0x62)
  assert large.EncodeSegment()
  assert large.Token(0) == 3
  large.BeginSegment()
  assert large.Accept(0xc3)
  assert large.Accept(0xa9)
  assert large.EncodeSegment()
  assert large.Token(1) == 5
 }
 @Test fn ExactWideCostAccumulation() {
  a.Wide(true)
  small.Reset()
  assert small.Accept(0x61)
  assert small.Accept(0x62)
  assert small.Accept(0x61)
  assert small.Accept(0x62)
  assert small.EncodeSegment()
  assert small.Count() == 2
  assert small.Token(0) == 3
  assert small.Token(1) == 3
  a.Wide(false)
 }
 @Test fn InvalidUtf8CapacityAndReset() {
  small.Reset()
  assert small.Accept(0xc0)
  assert !small.EncodeSegment()
  assert small.Failed()
  assert small.Count() == 0
  small.Reset()
  for (var i = 0; i < 8; i++) { assert small.Accept(0x61) }
  assert !small.Accept(0x61)
  assert !small.EncodeSegment()
  small.Reset()
  for (var i = 0; i < 5; i++) { assert small.Accept(0x61) }
  assert !small.EncodeSegment()
  assert small.Count() == 0
  small.Reset()
  assert small.Accept(0x61)
  assert small.EncodeSegment()
  assert small.Count() == 1
 }
 @Test fn NormalizationBoundsAndAlternateProvider() {
  norm.Reset()
  assert norm.Accept(0x20)
  assert norm.Accept(0x20)
  assert norm.Accept(0x61)
  assert norm.Accept(0x20)
  assert norm.Length() == 7
  assert norm.Read(0) == 0xe2
  assert norm.Read(3) == 0x61
  assert !norm.Accept(0x62)
  assert norm.Length() == 0
  norm.Reset()
  assert !norm.Accept(0x09)
  lower.Reset()
  assert lower.Accept(0x41)
  assert lower.Read(3) == 0x61
  assert lower.Length() == 4
 }
 @Test fn Utf8DecodeSpecialSlotsAndFailureAtomicity() {
  decoder.Reset()
  assert decoder.Append(6)
  assert decoder.Append(8)
  assert decoder.Append(4)
  assert decoder.Length() == 0
  assert decoder.Append(5)
  assert decoder.Append(4)
  assert decoder.Length() == 3
  assert decoder.Read(0) == 0xc3
  assert decoder.Read(1) == 0xa9
  assert decoder.Read(2) == 0x20
  assert !decoder.Append(-1)
  assert decoder.Length() == 0
  assert !decoder.Append(1)
  decoder.Reset()
  for (var i = 0; i < 8; i++) { assert decoder.Append(1) }
  assert !decoder.Append(1)
  assert decoder.Length() == 0
  other.Reset()
  assert other.Append(4)
  assert other.Append(1)
  assert other.Length() == 1
 }
}
