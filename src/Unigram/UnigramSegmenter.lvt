namespace Eccelerators.Tokenization.Unigram
/** Exact Viterbi per pre-tokenized UTF-8 segment. Strict improvement retains the
 * first path on equal cost (ascending start and prefix length). Unknown runs
 * fuse only within a segment. Output accumulates until Reset; errors invalidate
 * all output. UTF-8 is validated before trie execution.
 */
component UnigramSegmenter<MAX_BYTES: int, MAX_TOKENS: int, VOCAB: IUnigramVocabulary> {
 static assert MAX_BYTES > 0 && MAX_BYTES <= 4096, "invalid segment capacity"
 static assert MAX_TOKENS > 0 && MAX_TOKENS <= 4096, "invalid token capacity"
 vocab: VOCAB
 data: byte[MAX_BYTES]
 const SLOTS: int = MAX_BYTES + 1
 costs: logic[SLOTS, 64]
 previous: int[SLOTS]
 ids: int[SLOTS]
 widths: int[MAX_BYTES]
 reverse: int[MAX_BYTES]
 output: int[MAX_TOKENS]
 length: int
 count: int
 error: bool
 new(vocab: VOCAB) { this.vocab = vocab }
 public fn Reset() { length = 0
  count = 0
  error = false }
 public fn BeginSegment() { length = 0 }
 fn Fail() bool { error = true
  count = 0
  return false }
 public fn Accept(value: byte) bool {
  if (error || length >= MAX_BYTES) { return Fail() }
  data[length] = value
  length++
  return true
 }
 fn Candidate(start: int, end: int, id: int, cost: logic[64]) bool {
  if (id < 0 || cost > (1 as logic[64] << 40)) { return false }
  var total: logic[64] = 0
  var carry = 0
  var prior = costs[start]
  for (var limb = 0; limb < 4; limb++) {
   var shift = limb * 16
   var sum = ((prior >> shift) & 65535) as int + ((cost >> shift) & 65535) as int + carry
   total = total | ((sum & 65535) as logic[64] << shift)
   carry = sum >> 16
  }
  if (previous[end] < 0 || total < costs[end]) {
   costs[end] = total
   previous[end] = start
   ids[end] = id
  }
  return true
 }
 public fn EncodeSegment() bool {
  if (error || length == 0) { return Fail() }
  for (var i = 0; i <= length; i++) { previous[i] = -1 }
  var p = 0
  while (p < length) {
   var b = data[p] as int
   var n = 0
   if (b < 128) { n = 1 }
   if (b >= 194 && b <= 223) { n = 2 }
   if (b >= 224 && b <= 239) { n = 3 }
   if (b >= 240 && b <= 244) { n = 4 }
   if (n == 0) { return Fail() }
   if (p + n > length) { return Fail() }
   for (var j = 1; j < n; j++) {
    var c = data[p + j] as int
    if (c < 128 || c > 191) { return Fail() }
   }
   if (n >= 3) {
    var c = data[p + 1] as int
    if ((b == 224 && c < 160) || (b == 237 && c >= 160) ||
        (b == 240 && c < 144) || (b == 244 && c >= 144)) { return Fail() }
   }
   widths[p] = n
   for (var j = 1; j < n; j++) { widths[p + j] = 0 }
   p += n
  }
  costs[0] = 0
  previous[0] = 0
  p = 0
  while (p < length) {
   var n = widths[p]
   var node = 0
   var single = false
   var end = p
   while (end < length && node >= 0) {
    node = vocab.Next(node, data[end])
    end++
    if (node >= 0) {
     var id = vocab.Terminal(node)
     if (id >= 0 && (end == length || widths[end] != 0)) {
      if (!Candidate(p, end, id, vocab.Cost(id))) { return Fail() }
      if (end - p == n) { single = true }
     }
    }
   }
   if (!single) {
    if (!Candidate(p, p + n, vocab.Unknown(), vocab.UnknownCost())) { return Fail() }
   }
   p += n
  }
  if (vocab.Failed()) { return Fail() }
  p = length
  var size = 0
  var last = -1
  var unknown = vocab.Unknown()
  while (p > 0) {
   var id = ids[p]
   if (id != unknown || last != unknown) { reverse[size] = id
    size++ }
   last = id
   var next = previous[p]
   if (next < 0 || next >= p) { return Fail() }
   p = next
  }
  if (size > MAX_TOKENS - count) { return Fail() }
  for (var i = size - 1; i >= 0; i--) { output[count] = reverse[i]
   count++ }
  length = 0
  return true
 }
 public fn Count() int { return count }
 public fn Token(index: int) int {
  if (error || index < 0 || index >= count) { return -1 }
  return output[index]
 }
 public fn Failed() bool { return error }
}
